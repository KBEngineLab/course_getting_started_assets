<root>
    <Volatile>
        <position/>
        <yaw/>
        <optimized>false</optimized>
    </Volatile>
    <Properties>
        <!-- NPC名称 -->
        <name>
            <Type>UNICODE</Type>
            <Flags>ALL_CLIENTS</Flags>
        </name>
        <!-- NPC KEY -->
        <eid>
            <Type>UNICODE</Type>
            <Flags>ALL_CLIENTS</Flags>
        </eid>
        <!-- 对话内容 -->
        <dialog>
            <Type>PY_LIST</Type>
            <Flags>CELL_PUBLIC</Flags>
        </dialog>

    </Properties>

    <Components>
        <!-- 移动组件 -->
        <motion>
            <Type>Motion</Type>
            <Persistent>false</Persistent>
        </motion>
    </Components>
    <BaseMethods>

    </BaseMethods>
    <CellMethods>

    </CellMethods>
    <ClientMethods>

    </ClientMethods>
</root>