<root>
    <Volatile>
        <position/>
        <yaw/>
        <optimized>true</optimized>
    </Volatile>
    <Properties>
        <!-- NPC名称 -->
        <name>
            <Type>UNICODE</Type>
            <Flags>ALL_CLIENTS</Flags>
        </name>
        <!-- NPC KEY -->
        <eid>
            <Type>UNICODE</Type>
            <Flags>ALL_CLIENTS</Flags>
        </eid>
        <!-- 对话内容 -->
        <dialog>
            <Type>PY_LIST</Type>
            <Flags>CELL_PUBLIC</Flags>
        </dialog>
        <moveSpeed>
            <Type>UINT8</Type>
            <Flags>ALL_CLIENTS</Flags>
        </moveSpeed>
    </Properties>
    <BaseMethods>

    </BaseMethods>
    <CellMethods>
        <helloNPC>
            <Exposed/>
        </helloNPC>
    </CellMethods>
    <ClientMethods>
        <onHelloNPC>
            <!-- NPC说的话 -->
            <Arg>UNICODE</Arg>
        </onHelloNPC>
    </ClientMethods>
</root>